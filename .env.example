# Copy to .env (never commit .env). All optional: the app works offline without them.
EXPO_PUBLIC_SUPABASE_URL=https://REPLACE.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=REPLACE_WITH_goog_KEY
# AdMob banner unit id (ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ). Empty => NO ad in release builds
# (Google test ids are used only in __DEV__ builds).
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
# AdMob app id (ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY), read by app.config.js. REQUIRED for the EAS production profile.
ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADS_ENABLED=true
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://github.com/ANKHOSTING/TextCounter/blob/main/PRIVACY_POLICY.md
# LOCAL DEVELOPMENT ONLY: allow Google test AdMob ids (ignored/rejected for the EAS production profile). Never set in release builds.
# ADMOB_ALLOW_TEST_IDS=true
