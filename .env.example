# Copy to .env (never commit .env). All optional: the app works offline without them.
EXPO_PUBLIC_SUPABASE_URL=https://REPLACE.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=REPLACE_WITH_goog_KEY
# Real AdMob banner unit (release builds only; dev builds always use Google test ads)
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADS_ENABLED=true
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://github.com/ANKHOSTING/TextCounter/blob/main/PRIVACY_POLICY.md
